{
  "schemaVersion": 1,
  "id": "devin",
  "name": "Devin",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#7B2DFF",
  "auth": {
    "defaultStrategyId": "apiKey",
    "strategies": [
      {
        "id": "apiKey",
        "label": "API Key",
        "kind": "apiKey",
        "fields": [
          { "name": "apiKey", "label": "API Key", "secret": true, "required": true },
          { "name": "apiServerUrl", "label": "API Server URL", "placeholder": "https://server.codeium.com" }
        ],
        "credentialTemplate": { "apiKey": "", "apiServerUrl": "" }
      }
    ]
  },
  "links": [
    { "label": "Docs", "url": "https://docs.devin.ai/" },
    { "label": "Usage dashboard", "url": "https://app.devin.ai/" }
  ],
  "lines": [
    { "type": "progress", "label": "Weekly quota", "scope": "overview", "period": "weekly", "primaryOrder": 1 },
    { "type": "progress", "label": "Daily quota", "scope": "overview" },
    { "type": "text", "label": "Extra usage balance", "scope": "detail" }
  ]
}
